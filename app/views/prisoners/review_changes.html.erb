<% content_for :title, "Review allocation – Digital Prison Services" %>
<% content_for :turbolinks_nocache, 'true' %>

<%= link_to 'Back', review_allocations_prison_prisoners_path(@prison),
            class: 'govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-6' %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <div class="moj-page-header-actions govuk-!-margin-bottom-8">
      <div class="moj-page-header-actions__title">
        <h1 class="govuk-heading-l">Review allocation for <%= @prisoner.full_name_ordered %></h1>
        <span class="govuk-caption-l">Prison number: <%= @prisoner.offender_no %></span>
        <span class="govuk-caption-l">Date of birth: <%= format_date(@prisoner.date_of_birth) %> (<%= @prisoner.age %>)</span>
      </div>
    </div>

    <% @changes.each do |change| %>
      <div class="govuk-summary-card" aria-labelledby="review-change-<%= change.type %>">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title" id="review-change-<%= change.type %>">
            <%= change.title %>
          </h2>
        </div>
        <div class="govuk-summary-card__content">
          <% if change.explanation.present? %>
            <p class="govuk-body"><%= change.explanation %></p>
          <% end %>
          <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Date of change</dt>
              <dd class="govuk-summary-list__value"><%= change.changed_at %></dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Changed from</dt>
              <dd class="govuk-summary-list__value"><%= change.from_value %></dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Changed to</dt>
              <dd class="govuk-summary-list__value"><%= change.to_value %></dd>
            </div>
          </dl>
        </div>
      </div>
    <% end %>

    <div class="govuk-button-group govuk-!-margin-top-7">
      <%= link_to t('significant_changes.cta.reallocate'),
                  prison_prisoner_review_case_details_path(@prison.code, @prisoner.offender_no),
                  role: 'button', class: 'govuk-button', data: { module: 'govuk-button' } %>
    </div>
  </div>
</div>

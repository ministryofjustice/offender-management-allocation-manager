<tr class="govuk-table__row" id="primary-pom">
  <td class="govuk-table__cell">POM</td>
  <td class="govuk-table__cell table_cell__left_align" id="primary_pom_name">
    <% if @pom.present? %>
      <span>
        <%= link_to_if current_user_is_spo? && @pom.has_pom_role?, @pom.full_name.presence || 'Unknown',
                       prison_pom_path(allocation.prison, nomis_staff_id: @pom.staff_id), class: "govuk-link" %>
      </span>
    <% end %>
    <% if current_user_is_spo? %>
      <%= link_to(@pom.present? ? 'Reallocate' : 'Allocate',
                  prison_prisoner_review_case_details_path(allocation.prison, allocation.nomis_offender_id), class: "govuk-link pull-right") %>
    <% end %>
  </td>
</tr>

<tr class="govuk-table__row" id="co-working-pom">
  <td class="govuk-table__cell">Co-working POM</td>
  <td class="govuk-table__cell table_cell__left_align">
    <% if @coworker.present? %>
      <span>
        <%= link_to_if current_user_is_spo? && @coworker.has_pom_role?, @coworker.full_name.presence || 'Unknown',
                       prison_pom_path(allocation.prison, nomis_staff_id: @coworker.staff_id), class: "govuk-link" %>
      </span>
      <% if current_user_is_spo? %>
        <%= link_to 'Remove', prison_coworking_confirm_removal_path(allocation.prison, allocation.nomis_offender_id), class: "govuk-link pull-right" %>
      <% end %>
    <% else %>
      <% if current_user_is_spo? %>
        <%= link_to 'Allocate', prison_prisoner_review_case_details_path(allocation.prison, allocation.nomis_offender_id, coworking: true), class: "govuk-link pull-right" %>
      <% end %>
    <% end %>
  </td>
</tr>

<tr class="govuk-table__row">
  <td class="govuk-table__cell">Allocation history</td>
  <td class="govuk-table__cell table_cell__left_align">
    <%= last_event(allocation) %>
    <%= link_to 'View', history_prison_prisoner_allocation_path(allocation.prison, allocation.nomis_offender_id), class: "govuk-link pull-right" %>
  </td>
</tr>

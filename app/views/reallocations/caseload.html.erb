<% content_for :title, "Choose cases to reallocate – Digital Prison Services" %>

<%= render 'layouts/notice', notice: flash[:notice] %>

<%= link_to 'Back', prison_reallocation_path,
            class: 'govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-6' %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <% if flash[:alert] %>
      <div class="govuk-error-summary govuk-!-margin-bottom-8" aria-labelledby="reallocation-error-summary-title"
           role="alert" tabindex="-1" data-module="govuk-error-summary">
        <h2 id="reallocation-error-summary-title" class="govuk-error-summary__title">
          There is a problem
        </h2>

        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            <li><span class="app-error-summary__text"><%= flash[:alert] %></span></li>
          </ul>
        </div>
      </div>
    <% end %>

    <%= render partial: 'header_actions',
               locals: { title: 'Choose cases to reallocate', pom: @pom, new_pom: @new_pom } %>
  </div>

  <% selectable_count = @allocations.count { it.secondary_pom_nomis_id != @new_pom.staff_id } %>

  <div class="govuk-grid-column-full govuk-!-margin-top-2">
    <%= form_tag(caseload_prison_reallocation_path(@prison.code, @pom.staff_id, @new_pom.staff_id),
                 method: :post, data: { reallocation_case_selection: true }) do %>

      <div class="govuk-form-group govuk-!-padding-left-3 govuk-!-margin-bottom-2 reallocation-cases-table__select-all">
        <%= render 'select_all_cases', selectable_count:, position: 'top' %>
      </div>

      <%= render 'caseload_table', collection: @allocations, target_pom: @new_pom %>

      <div class="govuk-form-group govuk-!-padding-left-3 govuk-!-margin-bottom-7 reallocation-cases-table__select-all">
        <%= render 'select_all_cases', selectable_count:, position: 'bottom' %>
      </div>

      <%= submit_tag 'Continue', class: 'govuk-button', data: { module: 'govuk-button' } %>
    <% end %>
  </div>
</div>

<table class="govuk-table responsive poms-table">
  <%= case_mix_key %>
  <thead class="govuk-table__head">
  <tr class="govuk-table__row">
    <th class="govuk-table__header govuk-!-width-one-quarter" scope="col">POM</th>
    <th class="govuk-table__header poms-table__status-column" scope="col">Status</th>
    <th class="govuk-table__header govuk-!-width-one-third" scope="col">Case mix by tier</th>
    <% if @prison.womens? %>
      <th class="govuk-table__header poms-table__high-complexity-column" scope="col">High<br>complexity<br>cases</th>
    <% end %>
    <th class="govuk-table__header poms-table__narrow-column poms-table__total-cases-column" scope="col">Total cases</th>
  </tr>
  </thead>
  <tbody class="govuk-table__body">
  <% poms.each do |pom| %>
    <tr class="govuk-table__row">
      <td aria-label="POM and working pattern" class="govuk-table__cell poms-table__name-cell">
        <%= link_to full_name_ordered(pom), prison_pom_path(@prison.code, nomis_staff_id: pom.staff_id) %><br>
        <span class="govuk-!-margin-bottom-0"><%= format_working_pattern(pom.working_pattern, format: :short) %></span>
      </td>
      <td aria-label="Status" class="govuk-table__cell poms-table__status-column"><%= status(pom).capitalize %></td>
      <td aria-label="Case mix by tier" class="govuk-table__cell poms-table__case-mix-cell">
        <%= case_mix_bar_by_tiers(pom.allocations, preserve_space_if_none: true) %>
      </td>
      <% if @prison.womens? %>
        <td aria-label="High complexity cases" class="govuk-table__cell poms-table__high-complexity-column">
          <%= pom.allocations.count { it.complexity_level == 'high' } %>
        </td>
      <% end %>
      <td aria-label="Total cases" class="govuk-table__cell govuk-!-font-weight-bold poms-table__narrow-column poms-table__total-cases-column"><%= pom.allocations.count %></td>
    </tr>
  <% end %>
  </tbody>
</table>

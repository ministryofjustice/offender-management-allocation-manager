<% content_for :title, "POM caseload dashboard – Digital Prison Services" %>

<% if notice.present? %>
  <p class="notification govuk-!-margin-bottom-9" role="group" aria-labelledby="notice-heading">
    <%= notice %>
  </p>
<% end %>

<h1 class="govuk-heading-xl"><%= t('service_name') %></h1>

<%= render "search/search_box" %>

<% if @is_spo %>
  <h2 class="govuk-heading-m govuk-!-margin-bottom-0 govuk-!-margin-top-3">Allocate and manage cases</h2>
  <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-5">
  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               title: t('.tiles.make_allocations.title'),
               link: unallocated_prison_prisoners_path(@prison.code),
               content: t('.tiles.make_allocations.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.all_allocated_cases.title'),
               link: allocated_prison_prisoners_path(@prison.code),
               content: t('.tiles.all_allocated_cases.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.add_missing_details.title'),
               link: missing_information_prison_prisoners_path(@prison.code),
               content: t('.tiles.add_missing_details.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.review_allocations.title'),
               link: review_allocations_prison_prisoners_path(@prison.code),
               content: t('.tiles.review_allocations.content') if FeatureFlags.change_in_circumstances.enabled?
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.all_handover_cases.title'),
               link: upcoming_prison_handovers_path(@prison.code),
               content: t('.tiles.all_handover_cases.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.parole_cases.title'),
               link: prison_parole_cases_path(@prison.code),
               content: t('parole.upcoming.spo')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.help.title'),
               link: help_dashboard_path,
               content: t('.tiles.help.content')
    %>
  </div>

  <h2 class="govuk-heading-m govuk-!-margin-bottom-0 govuk-!-margin-top-3">Manage staff</h2>
  <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-5">
  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               title: t('.tiles.all_poms.title'),
               link: prison_poms_path(@prison.code),
               content: t('.tiles.all_poms.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.add_a_pom.title'),
               link: search_prison_onboarding_index_path(@prison.code, from: :home),
               content: t('.tiles.add_a_pom.content')
    %>
  </div>
<% end %>

<% if @is_pom %>
  <h2 class="govuk-heading-m govuk-!-margin-bottom-0 govuk-!-margin-top-3">Caseload information</h2>
  <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-5">
  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               title: t('.tiles.your_cases.title'),
               link: prison_staff_caseload_path(@prison.code, @staff_id),
               content: t('.tiles.your_cases.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.new_allocations.title'),
               link: prison_staff_caseload_cases_path(@prison.code, @staff_id, anchor: 'recent-allocations'),
               content: t('.tiles.new_allocations.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.your_handover_cases.title'),
               link: upcoming_prison_handovers_path(@prison.code, pom: 'user'),
               content: t('.tiles.your_handover_cases.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.parole_cases.title'),
               link: prison_staff_caseload_parole_cases_path(@prison.code, @staff_id),
               content: t('parole.upcoming.pom')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.case_updates_needed.title'),
               link: prison_staff_caseload_updates_required_path(@prison.code, @staff_id),
               content: t('.tiles.case_updates_needed.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.all_allocations.title'),
               link: prison_staff_caseload_global_path(@prison.code, @staff_id),
               content: t('.tiles.all_allocations.content')
    %>

    <%= render 'dashboard_partition',
               title: t('.tiles.help.title'),
               link: help_dashboard_path,
               content: t('.tiles.help.content') unless @is_spo
    %>
  </div>
<% end %>

<% content_for :title, "POM caseload dashboard – Digital Prison Services" %>

<% if notice.present? %>
  <p class="notification govuk-!-margin-bottom-9" role="group" aria-labelledby="notice-heading">
    <%= notice %>
  </p>
<% end %>

<% if @is_spo %>
  <div role="region" class="moj-alert moj-alert--information moj-alert--with-heading govuk-!-margin-bottom-8"
       aria-label="information" data-module="moj-alert">
    <div>
      <svg class="moj-alert__icon" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 30 30" height="30" width="30">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M10.2165 3.45151C11.733 2.82332 13.3585 2.5 15 2.5C16.6415 2.5 18.267 2.82332 19.7835 3.45151C21.3001 4.07969 22.6781 5.00043 23.8388 6.16117C24.9996 7.3219 25.9203 8.69989 26.5485 10.2165C27.1767 11.733 27.5 13.3585 27.5 15C27.5 18.3152 26.183 21.4946 23.8388 23.8388C21.4946 26.183 18.3152 27.5 15 27.5C13.3585 27.5 11.733 27.1767 10.2165 26.5485C8.69989 25.9203 7.3219 24.9996 6.16117 23.8388C3.81696 21.4946 2.5 18.3152 2.5 15C2.5 11.6848 3.81696 8.50537 6.16117 6.16117C7.3219 5.00043 8.69989 4.07969 10.2165 3.45151ZM16.3574 22.4121H13.6621V12.95H16.3574V22.4121ZM13.3789 9.20898C13.3789 8.98763 13.4212 8.7793 13.5059 8.58398C13.5905 8.38216 13.7044 8.20964 13.8477 8.06641C13.9974 7.91667 14.1699 7.79948 14.3652 7.71484C14.5605 7.63021 14.7721 7.58789 15 7.58789C15.2214 7.58789 15.4297 7.63021 15.625 7.71484C15.8268 7.79948 15.9993 7.91667 16.1426 8.06641C16.2923 8.20964 16.4095 8.38216 16.4941 8.58398C16.5788 8.7793 16.6211 8.98763 16.6211 9.20898C16.6211 9.43685 16.5788 9.64844 16.4941 9.84375C16.4095 10.0391 16.2923 10.2116 16.1426 10.3613C15.9993 10.5046 15.8268 10.6185 15.625 10.7031C15.4297 10.7878 15.2214 10.8301 15 10.8301C14.7721 10.8301 14.5605 10.7878 14.3652 10.7031C14.1699 10.6185 13.9974 10.5046 13.8477 10.3613C13.7044 10.2116 13.5905 10.0391 13.5059 9.84375C13.4212 9.64844 13.3789 9.43685 13.3789 9.20898Z" fill="currentColor"/>
      </svg>
    </div>
    <div class="moj-alert__content">
      <h2 class="moj-alert__heading">What’s new</h2>
      From 10 August 2026, you can use this service to reallocate multiple cases at the same time when POMs stop working
      at the prison either permanently or temporarily.
      <a href="https://justiceuk.sharepoint.com/:u:/r/sites/prisons-digital/SitePages/Manage%20POM%20Cases%20-%20What%27s%20New.aspx?d=w3e7bbfc4a10843b28ee3ffe0435c9bb7&csf=1&web=1&e=Sbtwib" target="_blank">
        Find out how it works in this video on SharePoint (opens in new tab)
      </a>
    </div>
    <div class="moj-alert__action">
      <button class="moj-alert__dismiss" hidden>Dismiss</button>
    </div>
  </div>
<% end %>

<h1 class="govuk-heading-xl govuk-!-margin-bottom-4"><%= t('service_name') %></h1>

<div class="govuk-!-margin-bottom-4">
  <%= render "search/search_box" %>
</div>

<% if @is_spo %>
  <h2 class="govuk-heading-m govuk-!-margin-bottom-0 govuk-!-margin-top-3">Allocate and manage cases</h2>
  <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-5">
  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               title: "Make allocations",
               link: unallocated_prison_prisoners_path(@prison.code),
               content: display_content(@unallocated_cases_count,
                                        no_cases: "You don’t have any cases to allocate currently.",
                                        one_case: "You have 1 case to allocate.",
                                        multiple_cases: "You have #{@unallocated_cases_count} cases to allocate.")
    %>

    <%= render 'dashboard_partition',
               title: "All allocated cases",
               link: allocated_prison_prisoners_path(@prison.code),
               content: "Everyone who has been allocated to POMs in this prison."
    %>

    <%= render 'dashboard_partition',
               title: "Add missing details",
               link: missing_information_prison_prisoners_path(@prison.code),
               content: display_content(@missing_details_cases_count,
                                        no_cases: "No cases are missing information right now.",
                                        one_case: "Missing details need to be added to 1 case before it can be allocated to a POM.",
                                        multiple_cases: "Missing details need to be added to #{@missing_details_cases_count} cases before they can be allocated to POMs.")
    %>
  </div>

  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               title: "View all handover cases",
               link: upcoming_prison_handovers_path(@prison.code),
               content: "Track the progress of cases being handed over to the community probation team."
    %>

    <%= render 'dashboard_partition',
               title: "Parole cases",
               link: prison_parole_cases_path(@prison.code),
               content: t('parole.upcoming.spo')
    %>

    <%= render 'dashboard_partition',
               title: "Get help with this service",
               link: help_dashboard_path,
               content: "Adding staff members, missing cases and problems with case responsibility."
    %>
  </div>

  <h2 class="govuk-heading-m govuk-!-margin-bottom-0 govuk-!-margin-top-3">Manage staff</h2>
  <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-5">
  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               new_badge: FeatureFlags.bulk_reallocation.enabled?,
               title: "View all POMs",
               link: prison_poms_path(@prison.code),
               content: "See what POMs are working on and change their availability."
    %>

    <%= render 'dashboard_partition',
               title: "Add a POM",
               link: search_prison_onboarding_index_path(@prison.code, from: :home),
               content: "Add a POM so you can allocate to them."
    %>
  </div>
<% end %>

<% if @is_pom %>
  <h2 class="govuk-heading-m govuk-!-margin-bottom-0 govuk-!-margin-top-3">Caseload information</h2>
  <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-5">
  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               title: "Your cases",
               link: prison_staff_caseload_path(@prison.code, @staff_id),
               content: "All cases allocated to you."
    %>

    <%= render 'dashboard_partition',
               title: "New allocations",
               link: prison_staff_caseload_cases_path(@prison.code, @staff_id, anchor: 'recent-allocations'),
               content: "Cases allocated to you in the last 7 days."
    %>

    <%= render 'dashboard_partition',
               title: "View your handover cases",
               link: upcoming_prison_handovers_path(@prison.code, pom: 'user'),
               content: "Keep track of your cases that must be handed over to the community probation team."
    %>
  </div>

  <div class="govuk-grid-row card-group">
    <%= render 'dashboard_partition',
               title: 'Parole cases',
               link: prison_staff_caseload_parole_cases_path(@prison.code, @staff_id),
               content: t('parole.upcoming.pom')
    %>

    <%= render 'dashboard_partition',
               title: "Case updates needed",
               link: prison_staff_caseload_updates_required_path(@prison.code, @staff_id),
               content: display_content(@case_updates_needed_count,
                                        no_cases: "You do not have any cases to update right now.",
                                        one_case: "Enter some information to ensure responsibility for this case is correct.",
                                        multiple_cases: "Enter some information to ensure responsibility for these cases is correct.")
    %>

    <%= render 'dashboard_partition',
               title: "All allocations in this prison",
               link: prison_staff_caseload_global_path(@prison.code, @staff_id),
               content: "Cases allocated to all POMs."
    %>

    <%= render 'dashboard_partition',
               title: "Get help with this service",
               link: help_dashboard_path,
               content: "Adding staff members, missing cases and problems with case responsibility." unless @is_spo
    %>
  </div>
<% end %>
